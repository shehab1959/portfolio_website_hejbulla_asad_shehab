# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Your live website address (no trailing slash). Used for SEO, sitemap and social previews.
# Change this after Vercel gives you your real URL.
NEXT_PUBLIC_SITE_URL=https://hejbulla-shehab.vercel.app

# OPTIONAL: Formspree form ID so the contact form sends messages straight to your inbox.
# Create a free form at https://formspree.io and paste only the ID (e.g. xyzabcde).
# If left empty, the contact form opens the visitor's email app addressed to you.
NEXT_PUBLIC_FORMSPREE_ID=
